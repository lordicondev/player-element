{
    "name": "@lordicon/element",
    "version": "3.0.2",
    "description": "The <lord-icon> custom element: animated Lordicon icons driven by markup, with triggers that react to control state.",
    "repository": "https://github.com/lordicondev/player-element",
    "homepage": "https://lordicon.com/",
    "keywords": [
        "lordicon",
        "lottie",
        "icon",
        "animation",
        "custom-element",
        "web-component"
    ],
    "author": "Lordicon <dev@lordicon.com>",
    "license": "MIT",
    "type": "module",
    "sideEffects": [
        "./dist/lordicon.js"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./lordicon": "./dist/lordicon.js",
        "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "jsdelivr": "./dist/lordicon.js",
    "unpkg": "./dist/lordicon.js",
    "files": [
        "dist",
        "README.md",
        "LICENSE.md",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "vite --config vite-examples.config.ts",
        "build": "vite build && vite build --mode standalone",
        "test": "vitest run",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check:types": "tsc --noEmit",
        "check": "npm run check:types && npm run lint && npm run format:check",
        "prepack": "npm run build"
    },
    "dependencies": {
        "@lordicon/web": "^2.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.5.1",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "happy-dom": "^20.14.5",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vite-plugin-dts": "^5.0.2",
        "vitest": "^5.0.1"
    }
}
